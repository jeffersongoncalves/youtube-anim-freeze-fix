{
  "manifest_version": 3,
  "name": "YouTube Animation Freeze Fix",
  "version": "2.4.3",
  "description": "Fixes YouTube video freezing/buffering caused by CSS or SVG/SMIL animations looping infinitely on any open tab.",
  "permissions": ["tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["youtube-detector.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["animation-throttle.js"],
      "run_at": "document_idle"
    }
  ]
}
